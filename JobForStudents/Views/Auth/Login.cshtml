@model JobForStudents.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="auth-page-container">
    <!-- Left Showcase Side -->
    <div class="auth-showcase-panel">
        <div class="auth-bg-shapes">
            <div class="auth-shape auth-shape-1"></div>
            <div class="auth-shape auth-shape-2"></div>
            <div class="auth-shape auth-shape-3"></div>
        </div>

        <!-- Branding Logo -->
        <a href="/" class="auth-brand" style="color: #ffffff;">
            <div class="auth-logo-icon" style="padding: 0; overflow: hidden; background: none; border: none; box-shadow: none; border-radius: 8px; width: 36px; height: 36px;">
                <img src="/images/logo exe.jpg" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" alt="Logo" />
            </div>
            <span class="auth-logo-text" style="color: #ffffff;">J4S</span>
        </a>

        <!-- Showcase Message -->
        <div class="auth-showcase-content" style="max-width: 500px;">
            <h1 style="font-size: 2.25rem; font-weight: 900; line-height: 1.3; margin-bottom: 20px; color: #ffffff; text-shadow: 0 4px 15px rgba(0, 0, 0, 0.55);">Kết Nối Việc Làm &amp; Kỹ Năng Sinh Viên</h1>
            <p style="font-size: 1.05rem; opacity: 0.98; line-height: 1.65; margin-bottom: 30px; color: #ffffff; text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5); font-weight: 600;">
                J4S (Jobs For Students) là nền tảng trực tuyến kết nối các cơ hội việc làm tự do (freelance) và việc làm ngắn hạn (micro-jobs) dành riêng cho sinh viên, là sản phẩm khởi nghiệp của sinh viên Trường Đại học FPT Cần Thơ.
            </p>
            
            <!-- Project Value Props (Decorations instead of fake stats) -->
            <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 30px;">
                <div style="background: rgba(15, 23, 42, 0.45); border: 1.5px solid rgba(255, 255, 255, 0.15); border-radius: 14px; padding: 16px 20px; display: flex; align-items: center; gap: 14px; backdrop-filter: blur(12px); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);">
                    <div style="font-size: 1.5rem; background: rgba(255, 255, 255, 0.2); width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: inset 0 0 10px rgba(255,255,255,0.2); flex-shrink: 0;">⚡</div>
                    <div>
                        <div style="font-weight: 800; color: #ffffff; font-size: 0.98rem; text-shadow: 0 1px 4px rgba(0,0,0,0.3);">Đăng tin &amp; Báo giá nhanh</div>
                        <div style="font-size: 0.82rem; color: rgba(255, 255, 255, 0.9); margin-top: 2px; line-height: 1.45; font-weight: 500;">Sinh viên dễ dàng nhận việc freelance linh hoạt phù hợp lịch học</div>
                    </div>
                </div>
                <div style="background: rgba(15, 23, 42, 0.45); border: 1.5px solid rgba(255, 255, 255, 0.15); border-radius: 14px; padding: 16px 20px; display: flex; align-items: center; gap: 14px; backdrop-filter: blur(12px); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);">
                    <div style="font-size: 1.5rem; background: rgba(255, 255, 255, 0.2); width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: inset 0 0 10px rgba(255,255,255,0.2); flex-shrink: 0;">🤝</div>
                    <div>
                        <div style="font-weight: 800; color: #ffffff; font-size: 0.98rem; text-shadow: 0 1px 4px rgba(0,0,0,0.3);">Đội ngũ tin cậy, xác thực</div>
                        <div style="font-size: 0.82rem; color: rgba(255, 255, 255, 0.9); margin-top: 2px; line-height: 1.45; font-weight: 500;">Quy trình xác thực hồ sơ nghiêm ngặt cho sinh viên và nhà tuyển dụng</div>
                    </div>
                </div>
                <div style="background: rgba(15, 23, 42, 0.45); border: 1.5px solid rgba(255, 255, 255, 0.15); border-radius: 14px; padding: 16px 20px; display: flex; align-items: center; gap: 14px; backdrop-filter: blur(12px); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);">
                    <div style="font-size: 1.5rem; background: rgba(255, 255, 255, 0.2); width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: inset 0 0 10px rgba(255,255,255,0.2); flex-shrink: 0;">🔒</div>
                    <div>
                        <div style="font-weight: 800; color: #ffffff; font-size: 0.98rem; text-shadow: 0 1px 4px rgba(0,0,0,0.3);">Thanh toán, ví điện tử nội bộ</div>
                        <div style="font-size: 0.82rem; color: rgba(255, 255, 255, 0.9); margin-top: 2px; line-height: 1.45; font-weight: 500;">Minh bạch giao dịch nạp rút và đánh giá hai chiều sau hợp đồng</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Note -->
        <div style="font-size: 0.85rem; opacity: 0.75; font-weight: 500; position: relative; z-index: 2;">
            &copy; 2026 J4S Platform. Kết nối tương lai.
        </div>
    </div>

    <!-- Right Form Side -->
    <div class="auth-form-panel">
        <div class="auth-form-wrapper">
            
            <!-- Branding for Mobile -->
            <div class="d-flex d-md-none justify-content-center mb-4">
                <a href="/" class="auth-brand">
                    <div class="auth-logo-icon" style="padding: 0; overflow: hidden; background: none; border: none; box-shadow: none; border-radius: 8px; width: 36px; height: 36px;">
                        <img src="/images/logo exe.jpg" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" alt="Logo" />
                    </div>
                    <span class="auth-logo-text">J4S</span>
                </a>
            </div>

            <div class="mb-4 text-center text-md-start">
                <h2 style="font-size: 1.85rem; font-weight: 800; color: #0f172a; margin-bottom: 8px;">Chào mừng quay trở lại!</h2>
                <p style="color: #64748b; font-size: 0.95rem; margin: 0;">Đăng nhập vào tài khoản J4S của bạn</p>
            </div>

            <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                <div asp-validation-summary="ModelOnly" id="loginValidationSummary" class="alert alert-danger small py-2 rounded-3 border-0 mb-4 animate-in d-none"></div>

                <!-- Email Input -->
                <div class="input-group-modern">
                    <label asp-for="Email">Email đăng nhập</label>
                    <div class="input-field-container">
                        <span class="input-field-icon">
                            <i data-lucide="mail" style="width: 18px; height: 18px;"></i>
                        </span>
                        <input asp-for="Email" type="email" class="input-field-modern" placeholder="name@example.com" required autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Password Input -->
                <div class="input-group-modern">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label asp-for="Password" class="mb-0">Mật khẩu</label>
                        <a asp-action="ForgotPassword" style="color: #2563eb; font-size: 0.8rem; font-weight: 600; text-decoration: none;">Quên mật khẩu?</a>
                    </div>
                    <div class="input-field-container">
                        <span class="input-field-icon">
                            <i data-lucide="lock" style="width: 18px; height: 18px;"></i>
                        </span>
                        <input asp-for="Password" type="password" class="input-field-modern password-input" id="passwordInput" placeholder="••••••" required autocomplete="current-password" />
                        <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('passwordInput', this)">
                            <i data-lucide="eye" style="width: 18px; height: 18px;"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Remember Me -->
                <div class="mb-4">
                    <label class="checkbox-modern">
                        <input asp-for="RememberMe" type="checkbox" />
                        <span class="checkbox-trigger">
                            <i data-lucide="check"></i>
                        </span>
                        <span>Lưu đăng nhập của tôi</span>
                    </label>
                </div>

                <!-- reCAPTCHA Widget (shown after 5 failed attempts) -->
                @if (ViewData["ShowCaptcha"] is true)
                {
                    <div class="mb-4">
                        <div class="g-recaptcha" 
                             data-sitekey="@ViewData["RecaptchaSiteKey"]"
                             data-callback="onRecaptchaSuccess"
                             data-expired-callback="onRecaptchaExpired"
                             style="transform: scale(0.96); transform-origin: 0 0;"></div>
                        <input type="hidden" name="RecaptchaToken" id="recaptchaTokenInput" />
                        <span class="text-danger small mt-1 d-block" id="captchaError" style="display:none !important;"></span>
                    </div>
                }

                <!-- Submit Button -->
                <button type="submit" class="btn-auth-submit" id="loginSubmitBtn">
                    Đăng nhập
                </button>

                <div class="text-center mt-4" style="font-size: 0.9rem; color: #64748b;">
                    Chưa có tài khoản? <a asp-action="Register" style="color: #2563eb; font-weight: 700; text-decoration: none;">Đăng ký thành viên</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (ViewData["ShowCaptcha"] is true)
    {
        <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    }
    <script>
        function togglePasswordVisibility(inputId, buttonEl) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const icon = buttonEl.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                if (icon) {
                    icon.setAttribute('data-lucide', 'eye-off');
                    if (window.lucide) lucide.createIcons();
                }
            } else {
                input.type = 'password';
                if (icon) {
                    icon.setAttribute('data-lucide', 'eye');
                    if (window.lucide) lucide.createIcons();
                }
            }
        }

        // reCAPTCHA callbacks
        function onRecaptchaSuccess(token) {
            document.getElementById('recaptchaTokenInput').value = token;
            var err = document.getElementById('captchaError');
            if (err) err.style.display = 'none';
        }
        function onRecaptchaExpired() {
            document.getElementById('recaptchaTokenInput').value = '';
        }

        document.addEventListener('DOMContentLoaded', function() {
            localStorage.setItem('j4s_active_tab', 'home');
            // Validate captcha before submit
            var form = document.querySelector('form');
            var captchaInput = document.getElementById('recaptchaTokenInput');
            if (form && captchaInput !== null) {
                form.addEventListener('submit', function(e) {
                    if (!captchaInput.value) {
                        e.preventDefault();
                        var err = document.getElementById('captchaError');
                        if (err) {
                            err.textContent = 'Vui lòng tích vào ô "Tôi không phải robot" trước khi đăng nhập.';
                            err.style.display = 'block';
                        }
                        // Scroll to captcha
                        document.querySelector('.g-recaptcha')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                });
            }

            // Show toast for validation errors
            var summary = document.getElementById('loginValidationSummary');
            if (summary && summary.textContent.trim().length > 0) {
                var errorMsg = "";
                var ul = summary.querySelector('ul');
                if (ul && ul.children.length > 0) {
                    errorMsg = ul.children[0].textContent;
                } else {
                    errorMsg = summary.textContent.trim();
                }
                if (window.showToast && errorMsg) {
                    setTimeout(function() {
                        window.showToast(errorMsg, 'error');
                    }, 100);
                }
            }
        });
    </script>
}
